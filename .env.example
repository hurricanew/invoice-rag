# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Using your own AWS CLI profile? Set AWS_PROFILE below.
# Using short-lived credentials sent by the project author instead? Delete
# the AWS_PROFILE line entirely and set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# / AWS_SESSION_TOKEN instead — see README.md Prerequisites and iam/README.md.
AWS_PROFILE=<your-aws-cli-profile-name>
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID is intentionally not set here — resolve it at run time via
# `aws sts get-caller-identity --profile $AWS_PROFILE --query Account --output text`
# rather than hardcoding it in any committed file.

BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

TOKEN_BUDGET_CEILING=100000
