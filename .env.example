# Copy to .env and fill in real values. .env is gitignored — never commit it.

AWS_PROFILE=rag-demo-2
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID is intentionally not set here — resolve it at run time via
# `aws sts get-caller-identity --profile $AWS_PROFILE --query Account --output text`
# rather than hardcoding it in any committed file.

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

TOKEN_BUDGET_CEILING=100000
